# Copy this file to .env. Never commit the populated .env file.

# Required for Telegram alerts.
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Optional for AI summaries. Without a key, title-and-link fallback alerts are sent.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# Cost guard: maximum new jobs summarized in one crawler run.
OPENROUTER_MAX_SUMMARIES_PER_RUN=25

# Opt in only when intentionally running a billable live OpenRouter smoke test.
# RUN_OPENROUTER_INTEGRATION=1
